---
import '../styles/global.css';
import { site } from '../data/site';
import { socials } from '../data/socials';
import studioLogo from '../assets/site/ms-studio-logo.png';
import WelcomeExperience from '../components/WelcomeExperience.astro';
import ThemeSwitcher from '../components/ThemeSwitcher.astro';
interface Props { title: string; description?: string; image?: string }
const { title, description = site.description, image = "/og-cover.webp" } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();
const ogImage = new URL(image, Astro.site ?? site.url).toString();
const full = title.includes('MS Studio') ? title : `${title} | MS Studio — Weddings by Umair`;
const nav = [['Portfolio','/portfolio/'],['Films','/films/'],['Packages','/packages/'],['Build Your Package','/build-your-package/'],['About','/about/'],['Contact','/contact/']];
const ld = { '@context':'https://schema.org','@type':'ProfessionalService',name:site.googleBusinessName,alternateName:site.name,url:site.url,telephone:site.phoneTel,
  description:site.description,areaServed:'Pakistan',address:{'@type':'PostalAddress',addressLocality:site.city,addressCountry:'PK'},
  founder:{'@type':'Person',name:site.founder,jobTitle:site.founderTitle},sameAs:socials.filter(s=>s.id!=='whatsapp').map(s=>s.url)};
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{full}</title>{!site.launchApproved && <meta name="robots" content="noindex, nofollow" />}<meta name="description" content={description} /><link rel="canonical" href={canonical} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <meta property="og:title" content={full} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:url" content={canonical} /><meta property="og:site_name" content={site.name} />
  <meta property="og:image" content={ogImage} /><meta property="og:image:alt" content="MS Studio — Weddings by Umair wedding photography" />
  <meta name="twitter:card" content="summary_large_image" /><meta name="twitter:image" content={ogImage} />
  <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap" rel="stylesheet" />
  <!-- Apply the saved theme before first paint to avoid a light-mode flash. -->
  <script is:inline>
    (() => {
      const key = 'msstudio_appearance';
      let preference = 'light';
      try {
        const stored = localStorage.getItem(key);
        if (stored === 'light' || stored === 'dark' || stored === 'system') preference = stored;
      } catch (_) { /* storage may be disabled; preserve the light-mode default */ }
      const dark = preference === 'dark' || (preference === 'system' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
      document.documentElement.dataset.theme = dark ? 'dark' : 'light';
      document.documentElement.style.colorScheme = dark ? 'dark' : 'light';
    })();
  </script>
  <script type="application/ld+json" set:html={JSON.stringify(ld)} />
</head>
<body>
  <WelcomeExperience />
  <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:z-50 focus:bg-white focus:p-3">Skip to content</a>
  <header class="ms-site-header sticky top-0 z-40 border-b border-beige bg-cream/90 backdrop-blur">
    <div class="wrap flex items-center justify-between gap-3 py-3 md:py-4">
      <a href="/" class="ms-header-logo inline-flex shrink-0 items-center" aria-label="MS Studio — Weddings by Umair, home">
        <img src={studioLogo.src} alt="MS Studio original red monogram" width="82" height="70" class="block h-[48px] w-auto object-contain sm:h-[56px] md:h-[66px]" decoding="async" fetchpriority="high" />
      </a>
      <div class="ml-auto flex min-w-0 items-center gap-2 sm:gap-4 lg:gap-6">
        <nav id="menu" class="ms-site-nav hidden items-center gap-5 text-[12px] font-semibold uppercase tracking-[0.10em] xl:flex xl:gap-7" aria-label="Main" data-mobile-open="false">
          {nav.map(([l,h]) => <a href={h} class="hover:text-burgundy" aria-current={Astro.url.pathname===h?'page':undefined}>{l}</a>)}
        </nav>
        <ThemeSwitcher />
        <button id="menu-btn" class="ms-mobile-toggle xl:hidden" type="button" aria-expanded="false" aria-controls="menu" aria-label="Open navigation menu">
          <svg class="ms-menu-svg" viewBox="0 0 24 24" width="21" height="21" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path class="ms-menu-bars" d="M4 7h16M4 12h16M4 17h16"/><path class="ms-menu-cross" d="M5 5l14 14M19 5L5 19" style="display:none"/></svg>
          <span class="ms-menu-label">Menu</span>
        </button>
      </div>
    </div>
  </header>
  <main id="main"><slot /></main>
  <footer class="mt-24 bg-ink text-ivory">
    <div class="wrap grid gap-10 py-14 md:grid-cols-3">
      <div><p class="font-serif text-[26px] font-medium">MS Studio</p><p class="mt-2 text-sm text-ivory/70">Weddings by {site.founder} · {site.city}, {site.country}</p>
        <p class="mt-4 text-sm"><a href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></p></div>
      <div class="text-sm"><p class="eyebrow !text-champagne">Explore</p><ul class="mt-3 space-y-2">
        {[...nav,['FAQ','/faq/'],['Terms','/terms/'],['Privacy','/privacy/'],['Founder','/founder/'],['Additional Services','/additional-services/']].map(([l,h]) => <li><a href={h} class="hover:text-champagne">{l}</a></li>)}</ul></div>
      <div class="text-sm"><p class="eyebrow !text-champagne">Follow &amp; Connect</p><ul class="mt-3 space-y-2">
        {socials.map((s) => <li><a href={s.url} target="_blank" rel="noopener noreferrer" class="hover:text-champagne">{s.label}</a></li>)}</ul></div>
    </div>
    <p class="border-t border-white/10 py-5 text-center text-xs text-ivory/50">© {new Date().getFullYear()} {site.name}. All rights reserved.</p>
  </footer>
  <script is:inline>
    (() => {
      const button = document.getElementById('menu-btn');
      const menu = document.getElementById('menu');
      if (!button || !menu) return;
      const label = button.querySelector('.ms-menu-label');
      const bars = button.querySelector('.ms-menu-bars');
      const cross = button.querySelector('.ms-menu-cross');
      const desktop = window.matchMedia('(min-width: 1280px)');
      const setOpen = (open) => {
        menu.dataset.mobileOpen = String(open);
        button.setAttribute('aria-expanded', String(open));
        button.setAttribute('aria-label', open ? 'Close navigation menu' : 'Open navigation menu');
        if (label) label.textContent = open ? 'Close' : 'Menu';
        if (bars) bars.style.display = open ? 'none' : '';
        if (cross) cross.style.display = open ? '' : 'none';
      };
      setOpen(false);
      button.addEventListener('click', () => setOpen(menu.dataset.mobileOpen !== 'true'));
      menu.querySelectorAll('a').forEach(link => link.addEventListener('click', () => setOpen(false)));
      document.addEventListener('pointerdown', (event) => {
        if (menu.dataset.mobileOpen === 'true' && !menu.contains(event.target) && !button.contains(event.target)) setOpen(false);
      });
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && menu.dataset.mobileOpen === 'true') { setOpen(false); button.focus(); }
      });
      if (desktop.addEventListener) desktop.addEventListener('change', () => setOpen(false));
      else desktop.addListener?.(() => setOpen(false));
    })();
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(entries => entries.forEach(entry => {
        if (entry.isIntersecting) { entry.target.classList.add('in'); io.unobserve(entry.target); }
      }), { threshold: .12 });
      document.querySelectorAll('.reveal').forEach(element => io.observe(element));
    } else document.querySelectorAll('.reveal').forEach(element => element.classList.add('in'));
  </script>
</body>
</html>
