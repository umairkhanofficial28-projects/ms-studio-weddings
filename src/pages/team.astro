---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { team } from '../data/team';
import { teamImage } from '../lib/team-images';
const members = team.filter(m=>m.visible).map(m=>({...m, portrait: teamImage(m.image)}));
---
<Base title="Meet Our Team" description="The creative team behind MS Studio — Weddings by Umair, Lahore.">
  <section class="wrap py-16 md:py-28"><p class="eyebrow">Behind the lens</p><h1 class="mt-3 text-5xl md:text-7xl">The people behind the stories.</h1>
    <p class="mt-5 max-w-xl leading-8 text-charcoal/70">Photography and film come alive through the people making them. Meet our founder and growing creative team.</p>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">{members.map(m=><article class="group">
      <div class="aspect-[4/5] overflow-hidden bg-beige">{m.portrait ? <Image src={m.portrait} alt={`Portrait of ${m.name}`} widths={[500,800]} sizes="(min-width:1024px) 33vw, (min-width:640px) 50vw, 100vw" class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" /> : <div class="flex h-full items-center justify-center p-8 text-center text-xs uppercase tracking-widest text-charcoal/45">Photo coming soon</div>}</div>
      <div class="pt-5"><p class="eyebrow">{m.position}</p><h2 class="mt-2 text-3xl">{m.name}</h2>
      {m.bio && !m.bio.startsWith('[') && <p class="mt-3 leading-7 text-charcoal/75">{m.bio}</p>}
      {m.specialization && <p class="mt-3 text-sm"><strong>Specialization:</strong> {m.specialization}</p>}
      {m.experience && <p class="mt-1 text-sm"><strong>Experience:</strong> {m.experience}</p>}
      <p class="mt-4 flex gap-4 text-xs uppercase tracking-wider">{m.socialUrl && <a class="underline" href={m.socialUrl} target="_blank" rel="noopener noreferrer">Profile</a>}{m.portfolioUrl && <a class="underline" href={m.portfolioUrl} target="_blank" rel="noopener noreferrer">Portfolio</a>}</p></div>
    </article>)}</div>
  </section>
</Base>
