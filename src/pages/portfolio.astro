---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { albums } from '../lib/albums';
---
<Base title="Wedding Photography Portfolio — Lahore" description="Explore our wedding photography collections at MS Studio — Weddings by Umair in Lahore, Pakistan.">
  <section class="wrap py-16 md:py-24">
    <div class="mb-10 text-center md:mb-14">
      <p class="eyebrow">Our portfolio</p>
      <h1 class="mt-4 text-5xl md:text-6xl">Wedding stories</h1>
    </div>
    {albums.length > 0 ? (
      <div class="catalog-grid" data-count={albums.length}>
        {albums.map((album, i) => (
          <a class="catalog-card" href={`/portfolio/${album.slug}/`} aria-label={`View wedding collection ${i + 1}`}>
            <Image src={album.cover} alt={`Wedding collection ${i + 1} cover`} widths={[400, 640, 900]} sizes="(min-width: 1024px) 31vw, (min-width: 640px) 48vw, 100vw" loading={i < 3 ? 'eager' : 'lazy'} class="catalog-photo" />
          </a>
        ))}
      </div>
    ) : (
      <p class="mx-auto max-w-xl py-20 text-center text-sm text-charcoal/60">Our new wedding collections are being prepared.</p>
    )}
  </section>
</Base>
