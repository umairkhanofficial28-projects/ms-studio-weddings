---
import Base from '../layouts/Base.astro';
import { Image } from 'astro:assets';
import { founder } from '../data/founder';
import { teamImage } from '../lib/team-images';
const portrait = teamImage(founder.photo);
---
<Base title="Umair Khan — Founder & Creative Director" description="Umair Khan, Founder & Creative Director of MS Studio — Weddings by Umair, Lahore.">
  <section class="wrap grid gap-12 py-16 md:grid-cols-2 md:py-28">
    <div class="aspect-[4/5] overflow-hidden bg-beige">
      {portrait ? <Image src={portrait} alt="Portrait of Umair Khan, founder of MS Studio" widths={[500,900,1200]} sizes="(min-width:768px) 50vw, 100vw" class="h-full w-full object-cover" /> : <div class="flex h-full items-center justify-center px-8 text-center text-xs uppercase tracking-widest text-charcoal/50">Founder's portrait to be added<br />src/assets/team/</div>}
    </div>
    <div class="self-center"><p class="eyebrow">{founder.title}</p><h1 class="mt-3 text-5xl md:text-7xl">{founder.name}</h1>
      {founder.bio.map(p=><p class="mt-5 leading-8 text-charcoal/80">{p}</p>)}
      <blockquote class="mt-8 border-l-2 border-burgundy pl-5 font-serif text-3xl italic">{founder.signatureMessage}</blockquote>
      <p class="mt-7 text-sm leading-7 text-charcoal/70">{founder.philosophy}</p>
      <div class="mt-8 flex flex-wrap gap-3">{founder.links.map(l=><a class="btn !py-2" href={l.url} target="_blank" rel="noopener noreferrer">{l.label}</a>)}</div>
    </div>
  </section>
</Base>
