---
import Base from '../layouts/Base.astro';
import { faq } from '../data/faq';
---
<Base title="Wedding Photography FAQ" description="Frequently asked questions about booking, delivery, revisions and outstation coverage with MS Studio.">
  <section class="wrap max-w-3xl py-16"><p class="eyebrow">FAQ</p><h1 class="mt-3 text-5xl">Questions, answered</h1>
  <div class="mt-10 divide-y divide-beige border-y border-beige">{faq.map(f=><details class="py-4"><summary class="cursor-pointer font-medium">{f.q}</summary><p class="mt-2 text-charcoal/80">{f.a}</p></details>)}</div></section>
</Base>
