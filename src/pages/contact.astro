---
import Base from '../layouts/Base.astro';
import { site, whatsappLink } from '../data/site';
import { socials, mapsEmbedSrc, directionsUrl, googleMaps } from '../data/socials';
import { packages } from '../data/packages';
const formAccessKey = (import.meta.env.PUBLIC_WEB3FORMS_KEY ?? '').trim();
---
<Base title="Contact & Book Your Wedding Date" description="Enquire about wedding photography and cinematography in Lahore with MS Studio — Weddings by Umair.">
  <section class="wrap grid gap-12 py-16 md:grid-cols-2"><div><p class="eyebrow">Contact</p><h1 class="mt-3 text-5xl">Booking Enquiry</h1>
    <p class="mt-4 text-sm text-charcoal/70">Submitting this form is an enquiry only — it does not confirm a booking. Our team will contact you to confirm availability.</p>
    {formAccessKey ? <form id="enq" method="POST" action="https://api.web3forms.com/submit" data-form-key={formAccessKey} class="mt-8 space-y-4">
      <input type="hidden" name="access_key" value={formAccessKey} />
      <input type="hidden" name="subject" value="New MS Studio wedding booking enquiry" />
      <input type="hidden" name="from_name" value="MS Studio Website" />
      <p class="hidden"><label>Don't fill this out: <input name="botcheck" /></label></p>
      <label class="block text-sm">Full name *<input class="field" name="name" required /></label>
      <label class="block text-sm">Phone / WhatsApp *<input class="field" name="phone" type="tel" required /></label>
      <label class="block text-sm">Email (optional)<input class="field" name="email" type="email" /></label>
      <div class="grid grid-cols-2 gap-4"><label class="block text-sm">Event date<input class="field" name="event_date" type="date" /></label>
        <label class="block text-sm">Event type<select class="field" name="event_type">{['Nikkah','Mehndi','Baraat','Walima','Engagement','Reception','Couple Shoot','Other'].map(e=><option>{e}</option>)}</select></label></div>
      <div class="grid grid-cols-2 gap-4"><label class="block text-sm">Venue<input class="field" name="venue" /></label><label class="block text-sm">City<input class="field" name="city" /></label></div>
      <label class="block text-sm">Package<select class="field" name="package"><option value="">Not sure yet</option>{packages.map(p=><option>{p.name}</option>)}<option>Bespoke package</option></select></label>
      <label class="block text-sm">Budget (optional)<input class="field" name="budget" /></label>
      <label class="block text-sm">Message<textarea class="field" name="message" rows="4"></textarea></label>
      <label class="block text-sm">Preferred contact<select class="field" name="contact_method"><option>WhatsApp</option><option>Phone call</option><option>Email</option></select></label>
      <label class="flex gap-2 text-sm"><input type="checkbox" name="consent" required /> I agree to be contacted about my enquiry. See <a class="underline" href="/privacy/">Privacy Policy</a>.</label>
      <button class="btn btn-solid" id="enq-btn">Send Enquiry</button><p id="enq-msg" role="status" class="text-sm"></p>
    </form> : <div class="mt-8 border border-beige bg-white p-6 text-sm"><p>Online email enquiries are being configured. For now, please use WhatsApp to contact our studio.</p><a class="btn btn-solid mt-4" href={whatsappLink('Assalam o Alaikum, I would like to enquire about wedding coverage.')} target="_blank" rel="noopener noreferrer">Send Enquiry on WhatsApp</a></div>}</div>
    <div class="space-y-6"><div class="space-y-2 text-sm"><p><a class="underline" href={`tel:${site.phoneTel}`}>{site.phoneDisplay}</a></p>
      <a class="btn btn-solid" href={whatsappLink('Assalam o Alaikum, I would like to enquire about wedding coverage.')} target="_blank" rel="noopener noreferrer">WhatsApp Booking</a></div>
      <iframe title="MS Studio location on Google Maps" src={mapsEmbedSrc} class="h-72 w-full border-0" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      <p class="space-x-3"><a class="btn !py-2" href={directionsUrl} target="_blank" rel="noopener noreferrer">Get Directions</a><a class="btn !py-2" href={googleMaps.listingUrl} target="_blank" rel="noopener noreferrer">Google Listing</a></p>
      <p class="text-sm">{socials.map(s=><a class="mr-3 underline" href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a>)}</p></div></section>
  <script is:inline>
    const form = document.getElementById('enq');
    const message = document.getElementById('enq-msg');
    const button = document.getElementById('enq-btn');
    if (form && message && button) {
      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (button.disabled) return;
        button.disabled = true;
        button.textContent = 'Sending…';
        message.textContent = '';
        try {
          const payload = Object.fromEntries(new FormData(form).entries());
          payload.consent = 'yes';
          const response = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            body: JSON.stringify(payload),
          });
          const result = await response.json().catch(() => null);
          if (!response.ok || result?.success !== true) throw new Error('Not accepted');
          form.reset();
          message.textContent = 'Thank you — your enquiry was received. This is not a confirmed booking; our team will contact you.';
        } catch {
          message.textContent = 'The email enquiry could not be delivered. Please contact us on WhatsApp instead.';
        } finally {
          button.disabled = false;
          button.textContent = 'Send Enquiry';
        }
      });
    }
  </script>
</Base>
