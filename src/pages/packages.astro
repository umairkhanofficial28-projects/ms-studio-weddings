---
import Base from '../layouts/Base.astro';
import PackageCard from '../components/PackageCard.astro';
import { packages } from '../data/packages';
---
<Base title="Wedding Photography Packages Lahore" description="Wedding photography and cinematography packages in Lahore: Essential Love PKR 50,000, Signature PKR 100,000, Royal PKR 185,000.">
  <section class="wrap py-16"><p class="eyebrow">Packages 2025–26</p><h1 class="mt-3 text-5xl">Wedding Packages</h1>
  <p class="mt-4 max-w-xl text-charcoal/70">All prices in PKR. Any applicable taxes are added to the final invoice. Booking is confirmed by the studio only after the agreed payment is received. Contact us for current booking terms.</p>
  <div class="mt-12 grid gap-8 md:grid-cols-3">{packages.map(p=><PackageCard pkg={p} />)}</div>
  <p class="mt-10 text-center"><a class="btn" href="/additional-services/">View additional services</a></p></section>
</Base>
